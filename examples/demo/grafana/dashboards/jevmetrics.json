{
  "uid": "jevmetrics-demo",
  "title": "Jevmetrics \u2022 shadow retention",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "jevmetrics",
    "demo"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Shadow retention \u2022 all input preserved",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Default inference is **synthetic mock data**, not Jev judgments. The live override calls Jev; inspect the model panel below. Prospective reduction counts observed datapoints, **not unique series, storage savings, or model accuracy**. Allow 30 seconds for rate charts. Cold or expired assessments keep input."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prospective datapoint reduction",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(jevmetrics_policy_datapoints_total{mode=\"annotate\",decision=\"drop\"}[30s])) / sum(rate(jevmetrics_policy_datapoints_total{mode=\"annotate\"}[30s]))",
          "legendFormat": "Prospective datapoint reduction",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Actual instruments dropped (since start)",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jevmetrics_metrics_dropped_total) or vector(0)",
          "legendFormat": "Actual instruments dropped (since start)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Inference attempts (since start)",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jevmetrics_inference_requests_total)",
          "legendFormat": "Inference attempts (since start)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Policy decisions \u2022 datapoints / second",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision, reason) (rate(jevmetrics_policy_datapoints_total{mode=\"annotate\"}[30s]))",
          "legendFormat": "{{decision}} \u2022 {{reason}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Local cache hit ratio",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(jevmetrics_cache_hits_total[30s])) / (sum(rate(jevmetrics_cache_hits_total[30s])) + sum(rate(jevmetrics_cache_misses_total[30s])))",
          "legendFormat": "Local cache hit ratio",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Inference attempts / second",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jevmetrics_inference_requests_total[30s]))",
          "legendFormat": "Inference attempts / second",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Assessment retrieval latency \u2022 mean",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jevmetrics_score_duration_seconds_sum[60s])) / sum(rate(jevmetrics_score_duration_seconds_count[60s]))",
          "legendFormat": "Assessment retrieval latency \u2022 mean",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queue rejections / second",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(jevmetrics_queue_rejected_total[30s])) or vector(0)",
          "legendFormat": "Queue rejections / second",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Keep probability \u2022 instrument / model",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jev_metric_keep_probability",
          "legendFormat": "{{metric_name}} \u2022 {{jev_model}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Original datapoints still exported",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jevmetrics-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (__name__) ({job=\"demo-metrics\",demo_series=~\".+\",__name__=~\"demo_checkout_latency|demo_debug_payload_size|demo_worker_queue_depth|up\"})",
          "legendFormat": "{{__name__}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
